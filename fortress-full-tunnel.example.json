{
  "log": {
    "disabled": true
  },
  "dns": {
    "servers": [
      {
        "type": "tcp",
        "tag": "dns-remote",
        "server": "10.8.0.1",
        "server_port": 5335,
        "detour": "proxy"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30",
        "fd00:face:1::1/126"
      ],
      "auto_route": true,
      "strict_route": true,
      "route_exclude_address": [
        "127.0.0.0/8",
        "169.254.0.0/16",
        "<YOUR_SERVER_IP>/32"
      ],
      "stack": "mixed",
      "mtu": 1400,
      "dns_mode": "hijack"
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto-fastest",
        "Fortress-Reality-TCP",
        "Fortress-Hysteria2-Salamander",
        "Fortress-Hysteria2-Standard",
        "Fortress-TUIC5",
        "Fortress-Shadowsocks2022",
        "Fortress-WireGuard-Native"
      ],
      "default": "auto-fastest"
    },
    {
      "type": "urltest",
      "tag": "auto-fastest",
      "outbounds": [
        "Fortress-Reality-TCP",
        "Fortress-Hysteria2-Salamander",
        "Fortress-Hysteria2-Standard",
        "Fortress-TUIC5",
        "Fortress-Shadowsocks2022"
      ],
      "url": "https://www.google.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "vless",
      "tag": "Fortress-Reality-TCP",
      "server": "<YOUR_SERVER_IP>",
      "server_port": 443,
      "uuid": "<YOUR_UUID>",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "gateway.icloud.com",
        "reality": {
          "enabled": true,
          "public_key": "<YOUR_REALITY_PUBLIC_KEY>",
          "short_id": "<YOUR_REALITY_SHORT_ID>"
        },
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      }
    },
    {
      "type": "hysteria2",
      "tag": "Fortress-Hysteria2-Salamander",
      "server": "<YOUR_SERVER_IP>",
      "server_port": 9444,
      "password": "<YOUR_HYSTERIA2_PASSWORD>",
      "obfs": {
        "type": "salamander",
        "password": "<YOUR_SALAMANDER_PASSWORD>"
      },
      "tls": {
        "enabled": true,
        "server_name": "<YOUR_TLS_SERVER_NAME>",
        "alpn": [
          "h3"
        ],
        "certificate": [
          "<YOUR_CA_CERT_PEM>"
        ]
      }
    },
    {
      "type": "hysteria2",
      "tag": "Fortress-Hysteria2-Standard",
      "server": "<YOUR_SERVER_IP>",
      "server_port": 8443,
      "password": "<YOUR_HYSTERIA2_PASSWORD>",
      "tls": {
        "enabled": true,
        "server_name": "<YOUR_TLS_SERVER_NAME>",
        "alpn": [
          "h3"
        ],
        "certificate": [
          "<YOUR_CA_CERT_PEM>"
        ]
      }
    },
    {
      "type": "tuic",
      "tag": "Fortress-TUIC5",
      "server": "<YOUR_SERVER_IP>",
      "server_port": 9443,
      "uuid": "<YOUR_UUID>",
      "password": "<YOUR_HYSTERIA2_PASSWORD>",
      "congestion_control": "bbr",
      "tls": {
        "enabled": true,
        "server_name": "<YOUR_TLS_SERVER_NAME>",
        "alpn": [
          "h3"
        ],
        "certificate": [
          "<YOUR_CA_CERT_PEM>"
        ]
      }
    },
    {
      "type": "shadowsocks",
      "tag": "Fortress-Shadowsocks2022",
      "server": "<YOUR_SERVER_IP>",
      "server_port": 10443,
      "method": "2022-blake3-aes-256-gcm",
      "password": "<YOUR_SHADOWSOCKS_PASSWORD>"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "ip_cidr": [
          "::/0"
        ],
        "action": "reject"
      },
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_cidr": [
          "<YOUR_SERVER_IP>/32"
        ],
        "outbound": "direct"
      },
      {
        "outbound": "proxy"
      }
    ],
    "default_domain_resolver": "dns-remote"
  },
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "Fortress-WireGuard-Native",
      "system": false,
      "address": [
        "10.8.0.2/32"
      ],
      "private_key": "<YOUR_WG_CLIENT_PRIVATE_KEY>",
      "mtu": 1360,
      "peers": [
        {
          "address": "<YOUR_SERVER_IP>",
          "port": 51820,
          "public_key": "<YOUR_WG_SERVER_PUBLIC_KEY>",
          "allowed_ips": [
            "0.0.0.0/0"
          ],
          "persistent_keepalive_interval": 15
        }
      ]
    }
  ]
}
